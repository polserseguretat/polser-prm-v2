# ===== PRM POLSER — variables d'entorn (copia com a .env i omple) =====
# MAI commitgegis el .env real (està a .gitignore).

# --- PocketBase ---
# Hostname público (genera enlaces/emails correctos).
PUBLIC_URL=https://api.partners.polser.cat

# --- SMTP (envío de emails, ej. códigos OTP del login) ---
# Proveedor transaccional: Resend (smtp.resend.com, puerto 465/SSL).
EMAIL_FROM="POLSER SEGURETAT <no-reply@polser.cat>"
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=re_XXX_...   # API key de Resend

# --- Extensión OTP ---
# En desarrollo, revela el código OTP en la respuesta para probar sin SMTP.
# NUNCA activar en producción.
OTP_DEV_REVEAL=false

# --- Odoo (sync outbox + cron) ---
ODOO_URL=https://odoo.polser.cat
ODOO_DB=polser
ODOO_LOGIN=prm@polser.cat
ODOO_APIKEY=CHANGE_ME_STRONG

# --- Portal React (VITE_ -> compilado en el build) ---
# Endpoint de la API PocketBase. El build se hace desde /portal y se sirve
# desde el mismo binario PB (pb_public). En dev local: http://localhost:8090.
VITE_POCKETBASE_URL=http://localhost:8090
