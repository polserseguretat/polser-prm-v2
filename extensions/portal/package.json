{
  "name": "directus-endpoint-portal",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^12.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=cjs --platform=node --target=node20 --outfile=dist/index.js --footer:js=\"module.exports = module.exports.default;\"",
    "dev": "esbuild src/index.ts --bundle --format=cjs --platform=node --target=node20 --outfile=dist/index.js --watch"
  },
  "dependencies": {
    "@directus/errors": "^2.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}