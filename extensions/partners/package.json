{
  "name": "directus-hook-partners",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^12.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/index.js",
    "dev": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/index.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}